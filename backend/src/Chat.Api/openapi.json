{
  "openapi": "3.1.0",
  "info": {"title": "Chat API local MVP", "version": "1.0.0", "description": "One-to-one text and voice chat. SignalR endpoint: /hubs/chat."},
  "servers": [{"url": "/"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/health": {"get": {"security": [], "responses": {"200": {"description": "Healthy"}}}},
    "/api/auth/register": {"post": {"security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RegisterRequest"}}}}, "responses": {"201": {"$ref": "#/components/responses/Auth"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/auth/login": {"post": {"security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Auth"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/auth/refresh": {"post": {"security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefreshRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Auth"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/auth/me": {
      "get": {"responses": {"200": {"$ref": "#/components/responses/User"}, "401": {"$ref": "#/components/responses/Error"}}},
      "put": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateProfileRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/User"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/users": {"get": {"parameters": [{"name": "query", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Matching users excluding caller, at most 50", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/User"}}}}}}}},
    "/api/users/{id}": {"parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "get": {"description": "User details excluding caller", "responses": {"200": {"$ref": "#/components/responses/User"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/conversations": {
      "get": {"responses": {"200": {"description": "Conversations newest first", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Conversation"}}}}}}},
      "post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateConversationRequest"}}}}, "responses": {"201": {"$ref": "#/components/responses/Conversation"}, "200": {"$ref": "#/components/responses/Conversation"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/conversations/{id}/messages": {
      "parameters": [{"$ref": "#/components/parameters/ConversationId"}],
      "get": {"parameters": [{"name": "beforeSequence", "in": "query", "description": "Exclusive older-than cursor", "schema": {"type": "integer", "format": "int64", "minimum": 1}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 30}}], "responses": {"200": {"$ref": "#/components/responses/MessagePage"}, "404": {"$ref": "#/components/responses/Error"}}},
      "post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SendMessageRequest"}}}}, "responses": {"201": {"$ref": "#/components/responses/Message"}, "200": {"$ref": "#/components/responses/Message"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/conversations/{id}/voice": {"parameters": [{"$ref": "#/components/parameters/ConversationId"}], "post": {"description": "Upload an AAC M4A voice recording, up to 2 MB and 120 seconds. Idempotent by clientMessageId and content.", "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["clientMessageId", "durationMs", "audio"], "properties": {"clientMessageId": {"type": "string", "format": "uuid"}, "durationMs": {"type": "integer", "minimum": 1000, "maximum": 120000}, "audio": {"type": "string", "format": "binary"}, "replyToMessageId": {"type": "string", "format": "uuid"}}}}}}, "responses": {"201": {"$ref": "#/components/responses/Message"}, "200": {"$ref": "#/components/responses/Message"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/messages/{id}/audio": {"parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "get": {"description": "Download voice recording for a conversation member", "responses": {"200": {"description": "M4A audio", "content": {"audio/mp4": {"schema": {"type": "string", "format": "binary"}}}}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/conversations/{id}/read": {"parameters": [{"$ref": "#/components/parameters/ConversationId"}], "post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MarkReadRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Read"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/conversations/{id}/delivered": {"parameters": [{"$ref": "#/components/parameters/ConversationId"}], "post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MarkDeliveredRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Delivered"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/messages/{id}/reaction": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "put": {"description": "Add one reaction for the caller", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SetReactionRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Message"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "delete": {"description": "Remove all of the caller's reactions", "responses": {"200": {"$ref": "#/components/responses/Message"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/messages/{id}/reaction/{type}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, {"name": "type", "in": "path", "required": true, "schema": {"type": "string", "enum": ["heart", "like", "laugh", "wow", "sad", "angry"]}}],
      "delete": {"description": "Remove one reaction of the caller", "responses": {"200": {"$ref": "#/components/responses/Message"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/messages/{id}/recall": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "put": {"description": "Recall a message sent by the caller. Clears its content for both members and publishes MessageUpdated. Idempotent.", "responses": {"200": {"$ref": "#/components/responses/Message"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/messages/{id}/heart": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "put": {"description": "Add the caller's heart to a message; idempotent", "responses": {"200": {"$ref": "#/components/responses/Message"}, "404": {"$ref": "#/components/responses/Error"}}},
      "delete": {"description": "Remove the caller's heart from a message; idempotent", "responses": {"200": {"$ref": "#/components/responses/Message"}, "404": {"$ref": "#/components/responses/Error"}}}
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "parameters": {"ConversationId": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}},
    "responses": {
      "Auth": {"description": "Access token and rotated refresh token", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Auth"}}}},
      "User": {"description": "User", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/User"}}}},
      "MessageReply": {"type": "object", "required": ["id", "senderId", "text", "kind"], "properties": {"id": {"type": "string", "format": "uuid"}, "senderId": {"type": "string", "format": "uuid"}, "text": {"type": "string"}, "kind": {"type": "string", "enum": ["text", "voice"]}}},
      "Conversation": {"description": "Conversation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Conversation"}}}},
      "Message": {"description": "Message", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}},
      "MessagePage": {"description": "Newest-first page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MessagePage"}}}},
      "Read": {"description": "Read cursor", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Read"}}}},
      "Delivered": {"description": "Delivered cursor", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Delivered"}}}},
      "Error": {"description": "API error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
    },
    "schemas": {
      "User": {"type": "object", "required": ["id", "displayName", "email"], "properties": {"id": {"type": "string", "format": "uuid"}, "displayName": {"type": "string"}, "email": {"type": "string", "format": "email"}}},
      "Message": {"type": "object", "required": ["id", "clientMessageId", "conversationId", "senderId", "text", "sequence", "createdAt", "heartedBy", "reactions", "reactionSets", "kind", "voiceDurationMs", "isRecalled"], "properties": {"id": {"type": "string", "format": "uuid"}, "clientMessageId": {"type": "string", "format": "uuid"}, "conversationId": {"type": "string", "format": "uuid"}, "senderId": {"type": "string", "format": "uuid"}, "text": {"type": "string"}, "kind": {"type": "string", "enum": ["text", "voice"]}, "voiceDurationMs": {"type": ["integer", "null"]}, "replyTo": {"oneOf": [{"$ref": "#/components/schemas/MessageReply"}, {"type": "null"}]}, "sequence": {"type": "integer", "format": "int64"}, "createdAt": {"type": "string", "format": "date-time"}, "heartedBy": {"type": "array", "items": {"type": "string", "format": "uuid"}}, "reactions": {"type": "object", "additionalProperties": {"type": "string", "enum": ["heart", "like", "laugh", "wow", "sad", "angry"]}}, "reactionSets": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "enum": ["heart", "like", "laugh", "wow", "sad", "angry"]}}}, "isRecalled": {"type": "boolean"}}},
      "MessageReply": {"type": "object", "required": ["id", "senderId", "text", "kind"], "properties": {"id": {"type": "string", "format": "uuid"}, "senderId": {"type": "string", "format": "uuid"}, "text": {"type": "string"}, "kind": {"type": "string", "enum": ["text", "voice"]}}},
      "Conversation": {"type": "object", "required": ["id", "peer", "lastMessage", "unreadCount", "lastReadSequence", "peerLastReadSequence", "lastDeliveredSequence", "peerLastDeliveredSequence"], "properties": {"id": {"type": "string", "format": "uuid"}, "peer": {"$ref": "#/components/schemas/User"}, "lastMessage": {"oneOf": [{"$ref": "#/components/schemas/Message"}, {"type": "null"}]}, "unreadCount": {"type": "integer", "format": "int64"}, "lastReadSequence": {"type": "integer", "format": "int64", "description": "Current user's read cursor"}, "peerLastReadSequence": {"type": "integer", "format": "int64", "description": "Other member's read cursor"}, "lastDeliveredSequence": {"type": "integer", "format": "int64", "description": "Current user's delivery cursor"}, "peerLastDeliveredSequence": {"type": "integer", "format": "int64", "description": "Other member's delivery cursor"}}},
      "Auth": {"type": "object", "required": ["user", "accessToken", "refreshToken"], "properties": {"user": {"$ref": "#/components/schemas/User"}, "accessToken": {"type": "string"}, "refreshToken": {"type": "string"}}},
      "MessagePage": {"type": "object", "required": ["items", "nextCursor"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Message"}}, "nextCursor": {"type": ["integer", "null"], "format": "int64"}}},
      "Read": {"type": "object", "required": ["lastReadSequence"], "properties": {"lastReadSequence": {"type": "integer", "format": "int64"}}},
      "Delivered": {"type": "object", "required": ["lastDeliveredSequence"], "properties": {"lastDeliveredSequence": {"type": "integer", "format": "int64"}}},
      "ApiError": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}},
      "RegisterRequest": {"type": "object", "required": ["displayName", "email", "password"], "properties": {"displayName": {"type": "string", "maxLength": 80}, "email": {"type": "string", "format": "email"}, "password": {"type": "string", "minLength": 8, "maxLength": 128}}},
      "LoginRequest": {"type": "object", "required": ["email", "password"], "properties": {"email": {"type": "string", "format": "email"}, "password": {"type": "string"}}},
      "RefreshRequest": {"type": "object", "required": ["refreshToken"], "properties": {"refreshToken": {"type": "string"}}},
      "UpdateProfileRequest": {"type": "object", "required": ["displayName", "email"], "properties": {"displayName": {"type": "string", "minLength": 1, "maxLength": 80}, "email": {"type": "string", "format": "email", "maxLength": 254}}},
      "CreateConversationRequest": {"type": "object", "required": ["peerUserId"], "properties": {"peerUserId": {"type": "string", "format": "uuid"}}},
      "SendMessageRequest": {"type": "object", "required": ["clientMessageId", "text"], "properties": {"clientMessageId": {"type": "string", "format": "uuid"}, "text": {"type": "string", "minLength": 1, "maxLength": 4000}, "replyToMessageId": {"type": ["string", "null"], "format": "uuid"}}},
      "MarkReadRequest": {"type": "object", "required": ["throughSequence"], "properties": {"throughSequence": {"type": "integer", "format": "int64", "minimum": 0}}},
      "MarkDeliveredRequest": {"type": "object", "required": ["throughSequence"], "properties": {"throughSequence": {"type": "integer", "format": "int64", "minimum": 0}}},
      "SetReactionRequest": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string", "enum": ["heart", "like", "laugh", "wow", "sad", "angry"]}}}
    }
  }
}
